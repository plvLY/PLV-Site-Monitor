{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [
    "dashboard/src/env.d.ts"
  ],
  "include": [
    "netlify/**/*.ts",
    "netlify/**/*.mts",
    "db/**/*.ts",
    "db/**/*.mts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "drizzle.config.ts",
    "vitest.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dashboard",
    "tracker",
    "dist",
    ".netlify"
  ]
}
